{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "outskill-page-studio",
  "main": "apps/worker/src/index.js",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  // Static files (studio UI, page-kit CSS/JS) are served straight from the repo.
  // .assetsignore keeps server code, tests and secrets out of the public bundle.
  "assets": { "directory": ".", "binding": "ASSETS" },

  // Page designs saved from the studio. Created by `npm run setup`.
  "kv_namespaces": [
    { "binding": "PAGES", "id": "ff7f831692f34c7f971be5018ae4674e" }
  ]

  // Public address: pages at https://outskill.com/<path>/<campaign-name> (see README "Public domain").
  //   "vars": { "PUBLIC_BASE_URL": "https://outskill.com/resources" },
  // and, only if outskill.com is a zone on this Cloudflare account:
  //   "routes": [{ "pattern": "outskill.com/resources/*", "zone_name": "outskill.com" }],
  // PUBLIC_BASE_URL makes pages load their files under that path and the studio show and copy those links.

  // Applications go to the application backend (apps/worker/src/leads/FormsApiClient.js).
  // Both come from the environment only (no defaults in the code):
  //   FORM_API_URL     the backend address: a Worker variable (dashboard, or "vars" below) or `npx wrangler secret put FORM_API_URL`
  //   FORMS_API_TOKEN  `npx wrangler secret put FORMS_API_TOKEN`
  //   locally, both live in .dev.vars
  // Secret (npx wrangler secret put STUDIO_TOKEN): the password for publishing from /studio.
}
